<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:automatic-styles>
  <style:style style:name="TW" style:family="text">
   <style:text-properties fo:color="#ffffff" fo:font-size="24pt"/>
  </style:style>
  <style:style style:name="TWs" style:family="text">
   <style:text-properties fo:color="#ffffff" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="TB" style:family="text">
   <style:text-properties fo:color="#101010" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="GR" style:family="graphic">
   <style:graphic-properties draw:fill="gradient"
    draw:fill-gradient-name="G1" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GD" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#1a3557" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GW" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#ffffff" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GB" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#8b0000" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GG" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#1f6e43" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GF" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#333333" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GP" style:family="graphic">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#4a235a" draw:stroke="none"/>
  </style:style>
  <style:style style:name="GN" style:family="graphic">
   <style:graphic-properties draw:fill="none" draw:stroke="none"/>
  </style:style>
  <style:style style:name="TC1" style:family="table-cell">
   <style:table-cell-properties fo:background-color="#204a87"/>
  </style:style>
  <style:style style:name="TC2" style:family="table-cell">
   <style:table-cell-properties fo:background-color="#f4f4f4"/>
  </style:style>
 </office:automatic-styles>
 <office:styles>
  <draw:gradient draw:name="G1" draw:style="linear"
   draw:start-color="#123a6d" draw:end-color="#0a1f3c" draw:angle="900"/>
 </office:styles>
 <office:body><office:presentation>

  <draw:page draw:name="dark">
   <draw:rect draw:style-name="GD" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm"/>
   <draw:frame draw:style-name="GN" svg:width="24cm" svg:height="2cm" svg:x="2cm" svg:y="2cm">
    <draw:text-box><text:p><text:span text:style-name="TW">White title on the dark background</text:span></text:p></draw:text-box>
   </draw:frame>
   <draw:frame draw:style-name="GN" svg:width="24cm" svg:height="1.5cm" svg:x="2cm" svg:y="13.5cm">
    <draw:text-box><text:p><text:span text:style-name="TWs">Dark slide body line stays dark text</text:span></text:p></draw:text-box>
   </draw:frame>
  </draw:page>

  <draw:page draw:name="band">
   <draw:rect draw:style-name="GW" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm"/>
   <draw:rect draw:style-name="GB" svg:width="22cm" svg:height="2.5cm" svg:x="3cm" svg:y="3cm">
    <text:p><text:span text:style-name="TW">White text on the colored band</text:span></text:p>
   </draw:rect>
   <draw:rect draw:style-name="GG" svg:width="10cm" svg:height="6cm" svg:x="3cm" svg:y="7.5cm">
    <text:p><text:span text:style-name="TW">White label on the colored shape</text:span></text:p>
   </draw:rect>
  </draw:page>

  <draw:page draw:name="gradient">
   <draw:rect draw:style-name="GR" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm"/>
   <draw:frame draw:style-name="GN" svg:width="24cm" svg:height="2cm" svg:x="2cm" svg:y="3cm">
    <draw:text-box><text:p><text:span text:style-name="TW">White title on the gradient background</text:span></text:p></draw:text-box>
   </draw:frame>
  </draw:page>

  <draw:page draw:name="image">
   <draw:frame draw:style-name="GN" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm">
    <draw:image><office:binary-data></office:binary-data></draw:image>
   </draw:frame>
   <draw:frame draw:style-name="GN" svg:width="24cm" svg:height="2cm" svg:x="2cm" svg:y="3cm">
    <draw:text-box><text:p><text:span text:style-name="TW">White title on the image background</text:span></text:p></draw:text-box>
   </draw:frame>
  </draw:page>

  <draw:page draw:name="overflow">
   <draw:rect draw:style-name="GW" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm"/>
   <draw:rect draw:style-name="GP" svg:width="10cm" svg:height="2cm" svg:x="2cm" svg:y="4cm">
    <text:p><text:span text:style-name="TW">White text that runs wider than its shape box</text:span></text:p>
   </draw:rect>
  </draw:page>

  <draw:page draw:name="tableslide">
   <draw:rect draw:style-name="GW" svg:width="28cm" svg:height="15.75cm" svg:x="0cm" svg:y="0cm"/>
   <table:table table:name="T1" table:template="table">
    <table:table-column table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell table:style-name="TC1"><text:p><text:span text:style-name="TWs">Header one</text:span></text:p></table:table-cell>
     <table:table-cell table:style-name="TC1"><text:p><text:span text:style-name="TWs">Header two</text:span></text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="TC2"><text:p><text:span text:style-name="TB">plain cell one</text:span></text:p></table:table-cell>
     <table:table-cell table:style-name="TC2"><text:p><text:span text:style-name="TB">plain cell two</text:span></text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <draw:rect draw:style-name="GF" svg:width="28cm" svg:height="1.5cm" svg:x="0cm" svg:y="14cm">
    <text:p><text:span text:style-name="TWs">Footer band of the slide</text:span></text:p>
   </draw:rect>
  </draw:page>

 </office:presentation></office:body>
</office:document>
