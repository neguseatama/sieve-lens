<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
 office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:automatic-styles>
  <style:style style:name="PW" style:family="paragraph">
   <style:paragraph-properties fo:background-color="#24466d"/>
   <style:text-properties fo:color="#ffffff" fo:font-size="14pt"/>
  </style:style>
  <style:style style:name="PN" style:family="paragraph">
   <style:text-properties fo:color="#101010" fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="CW" style:family="text">
   <style:text-properties fo:color="#ffffff" fo:font-size="12pt"/>
  </style:style>
  <style:style style:name="CT" style:family="table-cell">
   <style:table-cell-properties fo:background-color="#5c3566"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1">
   <style:header><text:p><text:span text:style-name="PN">Document header line</text:span></text:p></style:header>
   <style:footer><text:p><text:span text:style-name="PN">Document footer line</text:span></text:p></style:footer>
  </style:master-page>
 </office:master-styles>
 <office:body><office:text>
  <text:p text:style-name="PN">Ordinary body paragraph of the document.</text:p>
  <text:p text:style-name="PW">White text on the shaded paragraph background.</text:p>
  <text:p text:style-name="PN">Another ordinary paragraph.</text:p>
  <table:table table:name="DocT">
   <table:table-column table:number-columns-repeated="2"/>
   <table:table-row>
    <table:table-cell table:style-name="CT"><text:p><text:span text:style-name="CW">Cell white one</text:span></text:p></table:table-cell>
    <table:table-cell table:style-name="CT"><text:p><text:span text:style-name="CW">Cell white two</text:span></text:p></table:table-cell>
   </table:table-row>
   <table:table-row>
    <table:table-cell><text:p text:style-name="PN">plain cell one</text:p></table:table-cell>
    <table:table-cell><text:p text:style-name="PN">plain cell two</text:p></table:table-cell>
   </table:table-row>
  </table:table>
  <office:annotation><text:p>Reviewer note inside an annotation.</text:p></office:annotation>
 </office:text></office:body>
</office:document>
